type: software
title: "Tariff exclusion evidence audit: source to input protocol for tariff exclusion decisions"
version: 1.0.0
date-released: "2026-10-25"
repository-code: "https://github.com/williamjay1/tariff-exclusion-evidence-audit"
url: "https://github.com/williamjay1/tariff-exclusion-evidence-audit"
license: MIT
authors:
  - family-names: Zhang
